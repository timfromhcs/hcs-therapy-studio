{
  "name": "@hcsmedia/therapy-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Typed client for the HCS Therapy Studio loopback API. Browser-safe, no Node built-ins.",
  "license": "Apache-2.0",
  "author": "hcsmedia and timfromhcs",
  "homepage": "https://github.com/timfromhcs/hcs-therapy-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/timfromhcs/hcs-therapy-studio.git",
    "directory": "packages/sdk-ts"
  },
  "keywords": [
    "local-first",
    "llama.cpp",
    "wellbeing",
    "psychoeducation",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
